FLASK_ENV=production
SECRET_KEY=CHANGE_ME_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

# SQLite (simple) — file lives under backend/instance/
DATABASE_URL=sqlite:///instance/bizlens.db

# Or Postgres on the same server:
# DATABASE_URL=postgresql://bizlens:PASSWORD@127.0.0.1:5432/bizlens

CORS_ORIGINS=https://bizlens.g1orga.dev
DEMO_SEED=true
PORT=8000

# Public URL (informational; tunnel terminates TLS)
PUBLIC_BASE_URL=https://bizlens.g1orga.dev

# Lens OCR is local (rapidocr) — no API keys required
# OCR_SPACE_API_KEY=
# OPENAI_API_KEY=
