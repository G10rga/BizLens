[Unit]
Description=BizLens (gunicorn)
After=network-online.target

[Service]
Type=simple
User=bizlens
Group=bizlens
WorkingDirectory=/opt/bizlens
EnvironmentFile=/opt/bizlens/.env
Environment=FLASK_ENV=production
# Cloudflared/other apps already occupy 8000/8001/8012 — bind loopback only.
ExecStart=/opt/bizlens/.venv/bin/gunicorn \
  --chdir /opt/bizlens/backend \
  run:app \
  --bind 127.0.0.1:8020 \
  --workers 1 \
  --threads 4 \
  --timeout 180 \
  --forwarded-allow-ips=127.0.0.1 \
  --access-logfile - \
  --error-logfile -
Restart=always
RestartSec=3
LimitNOFILE=65535
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
