FLASK_ENV=production
SECRET_KEY=CHANGE_ME_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

# PostgreSQL (main DB on the VPS) — created by: sudo ./deploy/setup-postgres.sh
DATABASE_URL=postgresql://bizlens:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/bizlens

# SQLite fallback (local/dev only):
# DATABASE_URL=sqlite:///instance/bizlens.db

CORS_ORIGINS=https://bizlens.g1orga.dev
# false = empty DB for your real sales; true = seed demo bakery
DEMO_SEED=false
PORT=8020

PUBLIC_BASE_URL=https://bizlens.g1orga.dev

# Lens OCR is local (rapidocr) — no API keys required
# OCR_SPACE_API_KEY=
# OPENAI_API_KEY=
