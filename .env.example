FLASK_ENV=development
SECRET_KEY=bizlens-dev-secret-key-32chars-min!
JWT_SECRET_KEY=bizlens-jwt-dev-secret-key-32ch!
DATABASE_URL=sqlite:///instance/bizlens.db
# PostgreSQL (local or Render — postgres:// URLs are auto-normalized):
# DATABASE_URL=postgresql://user:password@localhost:5432/bizlens
CORS_ORIGINS=*
DEMO_SEED=true

# Lens Mode OCR — free-first (no OpenAI required)
# 1) OCR.space free tier: https://ocr.space/ocrapi  (leave unset to use demo key "helloworld")
# OCR_SPACE_API_KEY=helloworld
# OCR_SPACE_LANGUAGE=eng
# OCR_SPACE_ENGINE=2
# 2) Local Tesseract (optional): install OS package + pip pytesseract
# 3) Paid optional:
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# Set automatically on Render:
# RENDER=true
# PORT=10000
