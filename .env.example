FLASK_ENV=development
SECRET_KEY=bizlens-dev-secret-key-32chars-min!
JWT_SECRET_KEY=bizlens-jwt-dev-secret-key-32ch!
DATABASE_URL=sqlite:///instance/bizlens.db
# PostgreSQL (local or Render — postgres:// URLs are auto-normalized):
# DATABASE_URL=postgresql://user:password@localhost:5432/bizlens
CORS_ORIGINS=*
DEMO_SEED=true

# Lens Mode OCR is LOCAL by default (rapidocr-onnxruntime) — no keys needed.
# Optional cloud (off unless set):
# OCR_SPACE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# Set automatically on Render:
# RENDER=true
# PORT=10000

# Ubuntu + Cloudflare Tunnel example:
# FLASK_ENV=production
# CORS_ORIGINS=https://bizlens.g1orga.dev
# PUBLIC_BASE_URL=https://bizlens.g1orga.dev
# PORT=8000
